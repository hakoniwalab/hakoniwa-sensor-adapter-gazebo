<?xml version="1.0"?>
<!-- Force-torque sensor without noise at 500 Hz, measured in the sensor frame. -->
<sdf version="1.11">
  <model name="arm">
    <link name="flange">
      <sensor name="ft" type="force_torque">
        <update_rate>500</update_rate>
        <force_torque>
          <frame>sensor</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </link>
  </model>
</sdf>
