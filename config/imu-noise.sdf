<?xml version="1.0"?>
<!-- IMU with Gaussian noise (gyro 0.0008726646 rad/s, accel 0.03 m/s^2) at 250 Hz. -->
<sdf version="1.11">
  <model name="vehicle">
    <link name="body">
      <sensor name="imu" type="imu">
        <update_rate>250</update_rate>
        <topic>/hakoniwa/imu</topic>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev><bias_mean>0</bias_mean><bias_stddev>0</bias_stddev></noise>
            </x>
            <y>
              <noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev><bias_mean>0</bias_mean><bias_stddev>0</bias_stddev></noise>
            </y>
            <z>
              <noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev><bias_mean>0</bias_mean><bias_stddev>0</bias_stddev></noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0</bias_mean><bias_stddev>0</bias_stddev></noise>
            </x>
            <y>
              <noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0</bias_mean><bias_stddev>0</bias_stddev></noise>
            </y>
            <z>
              <noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0</bias_mean><bias_stddev>0</bias_stddev></noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
  </model>
</sdf>
