<?xml version="1.0"?>
<!-- Magnetometer with Gaussian noise of 1e-8 T (10 nT) per axis at 100 Hz. -->
<sdf version="1.11">
  <model name="vehicle">
    <link name="body">
      <sensor name="mag" type="magnetometer">
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><mean>0</mean><stddev>1e-8</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>1e-8</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>1e-8</stddev></noise></z>
        </magnetometer>
      </sensor>
    </link>
  </model>
</sdf>
