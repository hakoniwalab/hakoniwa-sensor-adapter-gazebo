        "noise": {
          "@type": "gaussian",
          "mean": 0,
          "stddev": 1e-08
        }
      },
      "z": {
        "noise": {
          "@type": "gaussian",
          "mean": 0,
          "stddev": 1e-08
        }
      }
    }
  }
}
